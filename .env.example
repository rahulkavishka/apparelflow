# Runtime (pooled, serverless-safe)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Migrations (direct or session pooler)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# JWT Auth (256-bit / 64-hex-char secret: generate via `openssl rand -hex 32`)
JWT_SECRET="replace-with-64-character-hex-secret-from-openssl-rand-hex-32"
JWT_EXPIRES_IN="8h"

# Application Origin
APP_ORIGIN="http://localhost:3000"

# Demo Mode (enables Role Switcher and Demo Credential Panel)
NEXT_PUBLIC_DEMO_MODE="true"
SEED_DEMO_ORDERS="false"

# Tests only — must NOT point at production
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/apparelflow_test"
